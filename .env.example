# Copy to .env and fill in. Only MS_CLIENT_ID is required.
# (The loader doesn't strip inline comments, so keep comments on their own lines.)

# Azure app registration (README "Azure setup")
MS_CLIENT_ID=

# LLM backend: "ollama" (local, default) or "anthropic"
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.8:27b
# Ignored under docker compose, which points at host.docker.internal
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# Only for LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Candidate specifics (README "Personal configuration"); the résumé and free-text
# constraints live in data/resume.txt and data/profile.md (see profile.example.md)
# GRADUATION_YEAR=2027
# LOCAL_AREA=Pittsburgh, Monroeville
# PROFILE_PATH=data/profile.md

# Optional
# HEALTHCHECK_URL=https://hc-ping.com/...
# POLL_ENABLED=true
# POLL_INTERVAL_SECONDS=90
# BACKFILL_DAYS=90
# DISCOVERY_ENABLED=true
# DISCOVERY_INTERVAL_HOURS=24
# FEEDS_ENABLED=true
